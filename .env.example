# Server-side only. Never expose secrets with NEXT_PUBLIC_.

# --- Basic analysis ---
# Works with official YouTube captions when available from the server network.
# For reliable production transcripts on Vercel, set an external provider.
TRANSCRIPT_PROVIDER=
TRANSCRIPT_API_KEY=

# --- Real MP4 rendering (required for end-to-end Shorts) ---
# Point to the Docker worker (HTTPS in production).
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# --- Optional AI packaging hints ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- TikTok Content Posting API ---
# Create an app at https://developers.tiktok.com and enable Login Kit + Content Posting API.
# The redirect URI must exactly match the URI registered in TikTok Developer Portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/tiktok/callback
# Optional override; defaults to user.info.basic,video.publish
TIKTOK_SCOPES=user.info.basic,video.publish
# Long random server-only secret used to encrypt the TikTok token cookie.
TIKTOK_COOKIE_SECRET=
