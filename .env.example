# Server-side providers only. Never expose secrets with NEXT_PUBLIC_.

# Optional external transcript service (POST { videoId } → { segments })
TRANSCRIPT_PROVIDER=
TRANSCRIPT_API_KEY=

# When TRANSCRIPT_PROVIDER is empty, ShortForge tries official YouTube timedtext captions.

# Media render worker
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# Optional future AI enrichment
AI_PROVIDER=
AI_API_KEY=
