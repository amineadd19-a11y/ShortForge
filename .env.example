# Server-side only. Never expose secrets with NEXT_PUBLIC_.

# --- Basic analysis (works without these if YouTube captions exist) ---
# Optional external transcript service: POST { videoId } -> { segments: [{start,end,text}] }
TRANSCRIPT_PROVIDER=
TRANSCRIPT_API_KEY=

# When TRANSCRIPT_PROVIDER is empty, ShortForge tries official YouTube timedtext captions.

# --- Rendering (required for real MP4 output) ---
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# --- Optional AI enrichment (never required for core analysis) ---
# AI_PROVIDER must be an HTTPS endpoint if used.
AI_PROVIDER=
AI_API_KEY=
