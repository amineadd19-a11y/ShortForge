# Server-side only. Never expose secrets with NEXT_PUBLIC_.

# --- Basic analysis ---
# Works with official YouTube captions when available from the server network.
# For reliable production transcripts on Vercel, set an external provider.
TRANSCRIPT_PROVIDER=
TRANSCRIPT_API_KEY=

# --- Real MP4 rendering (required for end-to-end Shorts) ---
# Point to the Docker worker (HTTPS in production).
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=

# --- Optional AI packaging hints ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
