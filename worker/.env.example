# Render worker — never commit real secrets

PORT=8787
WORK_DIR=/tmp/shortforge

# Required: shared secret with the Next.js app (Bearer token)
RENDER_WORKER_TOKEN=

# Required: S3-compatible object storage for MP4 output
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional
ENABLE_FACE_TRACKING=false
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_MS=600000
